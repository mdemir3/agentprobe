{
  "name": "AgentProbe - Scheduled Quality Check",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 6
            }
          ]
        }
      },
      "name": "Run Every 6 Hours",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/targets/",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "url",
              "value": "={{ $json.target_url || 'http://localhost:8001' }}"
            },
            {
              "name": "name",
              "value": "={{ $json.target_name || 'Production Agent' }}"
            },
            {
              "name": "connector_type",
              "value": "api"
            }
          ]
        },
        "options": {}
      },
      "name": "Register Target",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [460, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/plans/",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "target_id",
              "value": "={{ $json.id }}"
            },
            {
              "name": "max_cases",
              "value": "20"
            }
          ]
        },
        "options": {}
      },
      "name": "Generate Test Plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [680, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/runs/",
        "method": "POST",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            {
              "name": "plan_id",
              "value": "={{ $json.id }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Run Tests",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [900, 300]
    },
    {
      "parameters": {
        "url": "http://localhost:8000/reports/{{ $json.id }}",
        "method": "POST",
        "options": {}
      },
      "name": "Generate Report",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1120, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "quality-check",
              "leftValue": "={{ $json.overall_score }}",
              "rightValue": 0.7,
              "operator": {
                "type": "number",
                "operation": "lt"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "name": "Quality Below 70%?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [1340, 300]
    },
    {
      "parameters": {
        "channel": "#ai-quality-alerts",
        "text": "=:rotating_light: *AgentProbe Quality Alert*\n\n*Target:* {{ $json.target_name }}\n*Grade:* {{ $json.grade }} ({{ Math.round($json.overall_score * 100) }}%)\n*Hallucination Rate:* {{ Math.round($json.hallucination_rate * 100) }}%\n*Tool Accuracy:* {{ Math.round($json.tool_accuracy * 100) }}%\n*Safety:* {{ Math.round($json.safety_pass_rate * 100) }}%\n\n*Tests:* {{ $json.passed_tests }} passed / {{ $json.failed_tests }} failed / {{ $json.error_tests }} errors\n\n*Recommendations:*\n{{ $json.recommendations.join('\\n• ') }}\n\n<http://localhost:3000/reports/{{ $json.id }}|View Full Report>",
        "otherOptions": {}
      },
      "name": "Slack Alert - Quality Drop",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 200]
    },
    {
      "parameters": {
        "channel": "#ai-quality-alerts",
        "text": "=:white_check_mark: *AgentProbe Quality Check Passed*\n\n*Target:* {{ $json.target_name }} — Grade *{{ $json.grade }}* ({{ Math.round($json.overall_score * 100) }}%)\nHallucination: {{ Math.round($json.hallucination_rate * 100) }}% | Tools: {{ Math.round($json.tool_accuracy * 100) }}% | Safety: {{ Math.round($json.safety_pass_rate * 100) }}%",
        "otherOptions": {}
      },
      "name": "Slack - All Good",
      "type": "n8n-nodes-base.slack",
      "typeVersion": 2.2,
      "position": [1560, 400]
    }
  ],
  "connections": {
    "Run Every 6 Hours": {
      "main": [
        [{"node": "Register Target", "type": "main", "index": 0}]
      ]
    },
    "Register Target": {
      "main": [
        [{"node": "Generate Test Plan", "type": "main", "index": 0}]
      ]
    },
    "Generate Test Plan": {
      "main": [
        [{"node": "Run Tests", "type": "main", "index": 0}]
      ]
    },
    "Run Tests": {
      "main": [
        [{"node": "Generate Report", "type": "main", "index": 0}]
      ]
    },
    "Generate Report": {
      "main": [
        [{"node": "Quality Below 70%?", "type": "main", "index": 0}]
      ]
    },
    "Quality Below 70%?": {
      "main": [
        [{"node": "Slack Alert - Quality Drop", "type": "main", "index": 0}],
        [{"node": "Slack - All Good", "type": "main", "index": 0}]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "meta": {
    "templateId": "agentprobe-scheduled-quality"
  }
}
