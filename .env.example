# Copy this file to `.env` in the same directory (pytest and load_dotenv only read `.env`, not this file).
#
# LLM Providers
ANTHROPIC_API_KEY=sk-ant-api03-...
OPENAI_API_KEY=your-openai-key

# Database
DATABASE_URL=postgresql+asyncpg://agentprobe:agentprobe@postgres:5432/agentprobe

# ChromaDB (RAG / hallucination ingestion)
# Default: local on-disk store at AGENTPROBE_CHROMA_DATA. Set AGENTPROBE_CHROMA_USE_HTTP=true
# to use CHROMA_HOST / CHROMA_PORT (e.g. docker-compose Chroma).
AGENTPROBE_CHROMA_DATA=.chromadb
AGENTPROBE_CHROMA_USE_HTTP=false
CHROMA_HOST=chromadb
CHROMA_PORT=8000

# AgentProbe Settings
AGENTPROBE_DEFAULT_MODEL=claude-sonnet-4-6
AGENTPROBE_CHEAP_MODEL=gpt-4o-mini
# MCP tool bridge (no provider API key in AgentProbe)
AGENTPROBE_USE_MCP_BRIDGE=false
AGENTPROBE_MCP_BRIDGE_URL=http://127.0.0.1:9000
AGENTPROBE_MCP_BRIDGE_TOOL=generate_test_plan
AGENTPROBE_MCP_BRIDGE_AUTH_TOKEN=
AGENTPROBE_MCP_BRIDGE_TIMEOUT_SECONDS=120
# Local Ollama (no API key required)
AGENTPROBE_USE_OLLAMA=false
OLLAMA_MODEL=llama3.2:latest
OLLAMA_BASE_URL=http://127.0.0.1:11434
AGENTPROBE_MAX_CONCURRENT_TESTS=10
AGENTPROBE_TOKEN_BUDGET=100000
AGENTPROBE_LOG_LEVEL=INFO
